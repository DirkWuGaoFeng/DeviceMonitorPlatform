# 换行策略: 避免 Windows 端 autocrlf 把 Linux 侧脚本改成 CRLF
# (症状: WSL/GitHub Actions 里 bash 报 "$'\r': command not found")
* text=auto

# 必须在 Linux/WSL/CI 侧保持 LF 的文件
*.sh   text eol=lf
*.py   text eol=lf
*.c    text eol=lf
*.h    text eol=lf
*.cpp  text eol=lf
*.hpp  text eol=lf
*.proto text eol=lf
# rosidl 接口定义: CRLF 会让适配器把行尾字符带进字段解析, 统一 LF
*.msg  text eol=lf
*.srv  text eol=lf
*.action text eol=lf
CMakeLists.txt text eol=lf
*.cmake text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# PowerShell 脚本保持 CRLF（PS 5.1 兼容；含中文的 .ps1 另需 UTF-8 BOM）
*.ps1  text eol=crlf

# 二进制/产物不入库，显式声明以防误判
*.png  binary
*.db   binary

# 取证原文: 入库后必须逐字节不变（文档里写的 bytes= 是 blob 大小;
# 若允许 autocrlf 在 checkout 时转 CRLF, 同一份证据在两台机器上会有两个字节数）
tools/diagnostics/evidence/*.txt text eol=lf
